# Timeouts for the outbound probes (milliseconds). Hard-capped at 15000ms
# server-side regardless of what's configured here.
TCP_TIMEOUT_MS=5000
UDP_TIMEOUT_MS=5000

# Rate limiting (per client IP, in-memory per serverless instance).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Whether hostnames (in addition to literal IPs) are accepted as targets.
# When true, hostnames are resolved server-side and every resolved
# address is validated against the private/reserved blocklist.
ALLOW_HOSTNAMES=true
